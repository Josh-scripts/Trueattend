# TrueAttend — Environment Variables
# Copy this to .env and fill in your values

FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key
JWT_SECRET_KEY=change-this-jwt-secret-too

# Database (SQLite for dev, PostgreSQL for prod)
# DATABASE_URL=postgresql://user:password@localhost:5432/trueattend

# Face Recognition
FACE_RECOGNITION_THRESHOLD=0.50
LIVENESS_DETECTION_ENABLED=true
FRAME_ANALYSIS_INTERVAL=2
ALERT_UNKNOWN_FACE_THRESHOLD=1

# File Storage
KNOWN_FACES_DIR=./known_faces
UPLOAD_FOLDER=./uploads

# Email (optional but recommended)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@trueattend.app

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
